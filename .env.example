# .env.example — замените эту строку на реальные значения в .env

# Google Sheets интеграция (опционально)
# Установите USE_GOOGLE_SHEETS=1 для использования Google Таблиц вместо CSV
USE_GOOGLE_SHEETS=0

# ID таблиц Google Sheets
GSHEET_1_ID=1SW9T3XYNyuyOEQvzNeQi4jVCm_SddgrK
GSHEET_1_GID=370240274
GSHEET_2_ID=1gGhZomKx5Mwwi1nzbkKECFq0_6XvrOvuHXp80L4IufQ
GSHEET_2_GID=0

# WBCredentials
WB_WBAUID=...
WB_X_WBAAS_TOKEN=...
WB_AUTHORIZATION=...
WB_DEVICE_ID=...
WB_WBX_VALIDATION_KEY=...
WB_WID_SDK_ID_TOKEN=...
WB_ROUTEB=...

WB_X_USERID=0
WB_DEVICEID_HEADER=site_...

# Параметры запросов
REQUEST_DELAY=1.5
MAX_RETRIES=3
REQUEST_TIMEOUT=20

# CSV источник и приемник (используются только когда USE_GOOGLE_SHEETS=0)
INPUT_CSV=1.csv
OUTPUT_CSV=2.csv